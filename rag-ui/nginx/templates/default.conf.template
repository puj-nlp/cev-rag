# Ventana a la Verdad - nginx origin behind Cloudflare.
# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${SITE_DOMAIN} is substituted (NGINX_ENVSUBST_FILTER=^SITE_ in the Dockerfile).

include /etc/nginx/snippets/cloudflare-realip.conf;

server_tokens off;

# ---------------------------------------------------------------------------
# Language detection: cookie (manual choice) > Accept-Language > CF-IPCountry > English
# ---------------------------------------------------------------------------
map $cookie_lang $lang_from_cookie {
    es      es;
    en      en;
    default "";
}

# First "es" or "en" tag in the browser preference list (browsers send it ordered by q)
map $http_accept_language $lang_from_header {
    "~*^(?:[^,]*,)*?\s*(?<al>es|en)(?:[-_;,]|$)" $al;
    default "";
}

# CF-IPCountry is only trusted when the TCP peer is a Cloudflare edge
geo $realip_remote_addr $from_cloudflare {
    default 0;
    include /etc/nginx/snippets/cloudflare-ranges.conf;
}

map "$from_cloudflare:$http_cf_ipcountry" $lang_from_country {
    "~*^1:(AR|BO|CL|CO|CR|CU|DO|EC|ES|GQ|GT|HN|MX|NI|PA|PE|PR|PY|SV|UY|VE)$" es;
    default en;
}

map "$lang_from_cookie:$lang_from_header:$lang_from_country" $preferred_lang {
    "~^(?<c>es|en):"       $c;
    "~^:(?<h>es|en):"      $h;
    "~^::(?<g>es|en)$"     $g;
    default                en;
}

# ---------------------------------------------------------------------------
# Rate limiting (origin-side; Cloudflare rate limiting rules sit in front)
# ---------------------------------------------------------------------------
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=ask:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN} localhost;

    # Cloudflare Origin CA certificate (SSL/TLS mode: Full (strict))
    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_protocols       TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 16k;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    # Root: redirect to the detected language
    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Vary "Accept-Language, Cookie" always;
        add_header Cache-Control "no-store" always;
        return 302 /$preferred_lang/;
    }

    # Localized SPA routes: /es/... and /en/...
    location ~ "^/(?<url_lang>es|en)(?<url_rest>/.*)?$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Set-Cookie "lang=$url_lang; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Strict" always;
        add_header Link "<https://${SITE_DOMAIN}/es$url_rest>; rel=\"alternate\"; hreflang=\"es\", <https://${SITE_DOMAIN}/en$url_rest>; rel=\"alternate\"; hreflang=\"en\", <https://${SITE_DOMAIN}/>; rel=\"alternate\"; hreflang=\"x-default\"" always;
        add_header Content-Language $url_lang always;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # Legacy routes from before the localized URLs
    location ~ ^/chats/(?<legacy_chat>[^/]+)$ {
        return 301 /$preferred_lang/chat/$legacy_chat;
    }
    location = /about {
        return 301 /$preferred_lang/about;
    }

    # Fingerprinted build assets
    location /static/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Question endpoint: expensive (embeddings + LLM), stricter limit
    location ~ ^/api/frontend/chats/[^/]+/messages$ {
        limit_req zone=ask burst=5 nodelay;
        proxy_pass http://rag-api:8000;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 120s;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://rag-api:8000;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Public files (favicon, logos, robots.txt, sitemap.xml); anything else goes to the localized SPA
    location / {
        try_files $uri @localize;
    }

    location @localize {
        return 302 /$preferred_lang$request_uri;
    }
}
