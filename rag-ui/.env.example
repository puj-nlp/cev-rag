# React App Environment Variables Example
# Copy this file to .env and configure your values

# API Configuration
REACT_APP_API_URL=/api

# No API key needed - authentication handled by backend origin validation

# Maintenance sign (dev / build-time fallback): off | banner | full
# In production set MAINTENANCE_MODE / MAINTENANCE_MESSAGE on the container instead (no rebuild needed)
REACT_APP_MAINTENANCE_MODE=off
REACT_APP_MAINTENANCE_MESSAGE=
